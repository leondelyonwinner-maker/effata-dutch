# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=development

# Local dev defaults to SQLite; Render injects DATABASE_URL for Postgres in production.
DATABASE_URL=sqlite+aiosqlite:///./effata_dutch.db

# Generate with: python -m app.cli hash-passcode "your-passcode"
APP_PASSCODE_HASH=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
